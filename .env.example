# Salin file ini menjadi .env.local lalu isi nilainya (lihat docs/SETUP.md).
# .env.local TIDAK di-commit (sudah ada di .gitignore).

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# RAHASIA: hanya dipakai Route Handlers (app/api), jangan pernah diberi awalan NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Dipakai di browser — isi dengan nilai yang sama seperti di atas (boleh publik)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# true = pakai data contoh tanpa database (untuk coba tampilan saja)
NEXT_PUBLIC_USE_MOCK=false
